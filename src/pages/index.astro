---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Calendar } from 'lucide-react';
import { SITE } from '../config';

const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const allPubs = await getCollection('publications');
const team = await getCollection('team');
const honors = await getCollection('honors');
const stats = [
  { value: allPubs.length, key: 'stats.publications', label: 'Publications' },
  { value: team.length, key: 'stats.members', label: 'Members' },
  { value: honors.length, key: 'stats.honors', label: 'Honors' },
];

const activities = (await getCollection('activities'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20 lg:pt-24 lg:pb-28 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6 reveal">{SITE.labName} · {SITE.university}</p>
        <h1 class="text-5xl sm:text-6xl lg:text-[4.5rem] text-gray-900 leading-[1.05] reveal">
          {SITE.hero.title}
        </h1>
        <p class="mt-6 text-xl text-gray-600 max-w-xl leading-relaxed reveal">
          {SITE.hero.subtitle}
        </p>
        <div class="mt-10 flex flex-wrap gap-3 reveal">
          <a href="/achievements" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors shadow-sm" data-i18n-key="hero.viewPubs">
            View Publications
          </a>
          <a href="/team" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-gray-300 text-gray-800 font-medium hover:bg-gray-100 transition-colors" data-i18n-key="hero.meetTeam">
            Meet the Team
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 reveal">
        <div class="relative">
          <div class="absolute -inset-3 rounded-[2rem] bg-blue-100/60 -rotate-2" aria-hidden="true"></div>
          <div class="relative aspect-[4/5] rounded-[1.75rem] overflow-hidden border border-gray-200 shadow-[0_20px_50px_-20px_rgba(31,29,26,0.35)]">
            {SITE.hero.image ? (
              <Image
                class="w-full h-full object-cover"
                src={SITE.hero.image}
                alt={SITE.hero.title}
                loading="eager"
                fetchpriority="high"
                quality={70}
                format="webp"
                widths={[480, 768, 1024]}
                sizes="(max-width: 1024px) 100vw, 40vw"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-blue-100 to-gray-100"></div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <dl class="grid grid-cols-3 border-y border-gray-200 divide-x divide-gray-200 reveal">
        {stats.map(s => (
          <div class="py-6 px-4 sm:px-8 text-center sm:text-left">
            <dt class="text-xs tracking-wider uppercase text-gray-500" data-i18n-key={s.key}>{s.label}</dt>
            <dd class="font-display text-4xl sm:text-5xl text-gray-900 mt-1">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Selected Publications -->
  <section class="py-20 bg-gray-50 border-y border-gray-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10 reveal">
        <div>
          <p class="eyebrow mb-3" data-i18n-key="nav.achievements">Achievements</p>
          <h2 class="text-3xl sm:text-4xl text-gray-900" data-i18n-key="section.selectedPubs">Selected Publications</h2>
        </div>
        <a href="/achievements" class="text-blue-700 hover:text-blue-800 font-medium flex items-center gap-1 group">
          <span data-i18n-key="section.viewAll">View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {papers.map(paper => (
          <div class="card overflow-hidden flex flex-col h-full reveal">
            {paper.data.cover && (
              <div class="h-48 overflow-hidden border-b border-gray-200 bg-gray-100">
                <Image
                  src={paper.data.cover}
                  alt={paper.data.title}
                  class="w-full h-full object-cover"
                  quality={80}
                  format="webp"
                  widths={[320, 480]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                />
              </div>
            )}
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl text-gray-900 mb-2 line-clamp-2 leading-snug">
                {paper.data.title}
              </h3>
              <p class="text-gray-600 mb-4 text-sm line-clamp-2 flex-grow">{paper.data.authors.join(', ')}</p>
              <div class="flex items-center justify-between text-sm mt-auto">
                <span class="font-medium text-blue-700 bg-blue-50 border border-blue-100 px-2.5 py-0.5 rounded-full">{paper.data.venue}</span>
                <span class="text-gray-500">{paper.data.year}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Activities -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10 reveal">
        <div>
          <p class="eyebrow mb-3" data-i18n-key="nav.activities">Activities</p>
          <h2 class="text-3xl sm:text-4xl text-gray-900" data-i18n-key="section.latestNews">Latest Activities</h2>
        </div>
        <a href="/activities" class="text-blue-700 hover:text-blue-800 font-medium flex items-center gap-1 group">
          <span data-i18n-key="section.viewAll">View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {activities.map(item => (
          <div class="card group overflow-hidden reveal">
            {item.data.cover && (
              <div class="h-48 overflow-hidden">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  quality={80}
                  format="webp"
                  widths={[320, 480, 600]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                />
              </div>
            )}
            <div class="p-6">
              <div class="text-sm text-gray-500 mb-2 flex items-center gap-2">
                <Calendar className="w-4 h-4" />
                {item.data.date.toLocaleDateString()}
              </div>
              <h3 class="text-xl text-gray-900 group-hover:text-blue-700 transition-colors mb-2 line-clamp-2 leading-snug">
                <a href={`/activities`}>{item.data.title}</a>
              </h3>
              <p class="text-gray-600 line-clamp-3 text-sm">{item.data.description || item.body.substring(0, 100)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
